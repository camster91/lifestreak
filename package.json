{
  "name": "lifestreak",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "Track habits, service, reading, and goals — all in one place",
  "scripts": {
    "dev": "vite",
    "start": "npm run dev:full",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "mobile:build": "npm run build && npm run cap:sync",
    "mobile:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "mobile:android": "npm run build && npx cap sync android && npx cap open android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:add:android": "npx cap add android",
    "android:build:debug": "npm run build && npx cap sync android && node scripts/run-gradle.js assembleDebug",
    "android:build:release": "npm run build && npx cap sync android && node scripts/run-gradle.js assembleRelease",
    "android:bundle": "npm run build && npx cap sync android && node scripts/run-gradle.js bundleRelease",
    "ios:build": "npm run build && npx cap sync ios",
    "dev:server": "node simple-api-server.js",
    "dev:vite": "vite",
    "dev:full": "concurrently \"npm run dev:vite\" \"npm run dev:server\" --names \"VITE,API\" --prefix-colors \"blue,green\""
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@xmldom/xmldom": "^0.9.10",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.12.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "daisyui": "^5.6.18",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "express": "^5.2.1",
    "globals": "^17.7.0",
    "http-proxy-middleware": "^3.0.5",
    "jsdom": "^27.4.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
